# Docker Compose 本地部署参数。复制为 .env 后再按需修改。
FRONTEND_PORT=8080
BACKEND_PORT=48080

MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_USER=lucky5
MYSQL_PASSWORD=lucky5
MYSQL_ROOT_PASSWORD=123456

JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom

# 系统级开奖源对应的后台账号。该账号只负责提供全平台统一期号和开奖号码。
LOTTERY_DRAW_SOURCE_TENANT_ID=1
LOTTERY_DRAW_SOURCE_USER_ID=1
